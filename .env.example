# Copy to .env and fill in. Never commit .env.

# Gemini (free tier): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# LLM provider: gemini (default) or ollama (local, run `ollama serve`)
LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REQUESTS_PER_MINUTE=10
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# LangSmith tracing (free Developer plan): https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ai-interview-prep
